DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=chits

# Empty locally. Production example:
# /cloudsql/PROJECT_ID:asia-south1:INSTANCE_ID
INSTANCE_UNIX_SOCKET=

SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://nexnidhi.in,https://www.nexnidhi.in

# Email features require these settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional OTP provider configuration; configure separately when enabling OTP.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Only for manual migration b7d20e3f0102 if no admin exists; use a secure secret.
BOOTSTRAP_ADMIN_PASSWORD=
