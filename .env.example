DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=chits

# Empty locally. Production example:
# /cloudsql/PROJECT_ID:asia-south1:INSTANCE_ID
INSTANCE_UNIX_SOCKET=

SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://nexnidhi.in,https://www.nexnidhi.in

# Email features require these settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Welcome emails use STARTTLS by default; for port 465 set TLS=false and SSL=true.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Enable only on the separately scheduled welcome worker after preview/review.
# API requests still queue durable intents while delivery is disabled.
WELCOME_EMAIL_DELIVERY_ENABLED=false

# Optional OTP provider configuration; configure separately when enabling OTP.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Only for manual migration b7d20e3f0102 if no admin exists; use a secure secret.
BOOTSTRAP_ADMIN_PASSWORD=

# Server-bound Super Admin recovery; set the registered Indian mobile.
SUPER_ADMIN_RESET_USERNAME=admin
SUPER_ADMIN_RESET_MOBILE=
# Optional dedicated approved MSG91 OTP template (falls back to MSG91_TEMPLATE_ID).
SUPER_ADMIN_MSG91_TEMPLATE_ID=

# Required on Cloud Run: private persistent bucket for company logos.
# Runtime service account needs roles/storage.objectUser on this bucket.
COMPANY_LOGO_BUCKET=
